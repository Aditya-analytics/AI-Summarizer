## Phase 6 — Workspace Wiring

### Chat Panel
```javascript
const [messages, setMessages] = useState([]);

const sendMessage = async (question) => {
  setMessages(prev => [...prev, { role: 'user', content: question }]);
  setMessages(prev => [...prev, { role: 'ai', content: '' }]);

  const reader = await api.askQuestion(documentId, question);
  await readStream(reader, (chunk) => {
    setMessages(prev => {
      const updated = [...prev];
      updated[updated.length - 1].content += chunk;
      return updated;
    });
  });
};
```

### Quiz Panel
```javascript
const generateQuiz = async () => {
  const quiz = await api.getQuiz(documentId, difficulty);
  setQuestions(quiz.questions);
  // quiz.questions = [{question, options, correct_answer, explanation}]
};

const checkAnswer = (question, selectedOption) => {
  return selectedOption === question.correct_answer;
};
```

### Notes Panel
```javascript
const generateNotes = async () => {
  const reader = await api.getNotes(documentId, length, language);
  setNotes('');
  await readStream(reader, chunk => setNotes(p => p + chunk));
};

// Render with:
// npm install react-markdown
import ReactMarkdown from 'react-markdown';
<ReactMarkdown>{notes}</ReactMarkdown>
```

